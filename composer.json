{
  "name": "thejano/areeba-payment-laravel",
  "description": "A Laravel package for Areeba payment gateway integration.",
  "type": "library",
  "require": {
    "php": ">=8.2",
    "illuminate/support": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "pestphp/pest": "^3.0|^4.0",
    "pestphp/pest-plugin-laravel": "^3.0|^4.0"
  },
  "autoload": {
    "psr-4": {
      "TheJano\\AreebaPayment\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TheJano\\AreebaPayment\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "extra": {
    "laravel": {
      "providers": [
        "TheJano\\AreebaPayment\\Providers\\AreebaPaymentServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "license": "MIT"
}
